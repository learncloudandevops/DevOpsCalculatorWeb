pipeline {
    agent any

    environment {
        AWS_REGION = 'us-east-1'
        ACCOUNT_ID = '425034746560'
        REPOSITORY = 'awsecrdemo'
        IMAGE_TAG = 'v1'
        ECR_REGISTRY = "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_IMAGE = "${ECR_REGISTRY}/${REPOSITORY}:${IMAGE_TAG}"
        JAVA_HOME = '/usr/lib/jvm/java-21-amazon-corretto.x86_64'
        PATH = "${JAVA_HOME}/bin:${PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Tools and AWS Identity') {
            steps {
                sh '''
                    set -eu
                    mvn --version
                    docker --version
                    aws --version
                    aws sts get-caller-identity
                '''
            }
        }

        stage('Build WAR') {
            steps {
                sh '''
                    set -eu
                    test -f pom.xml
                    grep -Eq '<packaging>war</packaging>' pom.xml || {
                        echo "ERROR: pom.xml must contain <packaging>war</packaging>"
                        exit 1
                    }
                    mvn -B clean package -DskipTests
                    WAR_FILE="$(find target -maxdepth 1 -type f -name '*.war' -print -quit)"
                    test -n "$WAR_FILE" || {
                        echo "ERROR: Maven did not produce a WAR file under target/"
                        exit 1
                    }
                    ls -lh "$WAR_FILE"
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eu
                    test -f Dockerfile || {
                        echo "ERROR: Dockerfile not found in the project root"
                        exit 1
                    }
                    docker build --pull -t "$ECR_IMAGE" .
                    docker image inspect "$ECR_IMAGE" >/dev/null
                '''
            }
        }

        stage('Login to Amazon ECR') {
            steps {
                sh '''
                    set -eu
                    aws ecr get-login-password --region "$AWS_REGION" |
                      docker login --username AWS --password-stdin "$ECR_REGISTRY"
                '''
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh '''
                    set -eu
                    docker push "$ECR_IMAGE"
                '''
            }
        }

        stage('Verify Image in ECR') {
            steps {
                sh '''
                    set -eu
                    aws ecr describe-images \
                      --region "$AWS_REGION" \
                      --repository-name "$REPOSITORY" \
                      --image-ids imageTag="$IMAGE_TAG"
                '''
            }
        }
    }

    post {
        success {
            echo "Successfully built and pushed ${ECR_IMAGE}"
        }
        failure {
            echo 'Docker build or ECR push failed. Review the stage logs above.'
        }
        always {
            sh 'docker logout "${ECR_REGISTRY}" >/dev/null 2>&1 || true'
        }
    }
}
