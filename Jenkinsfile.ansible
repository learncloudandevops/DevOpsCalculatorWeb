pipeline {
    agent any

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-21-amazon-corretto.x86_64'
        PATH = "${JAVA_HOME}/bin:${PATH}"
    //    SONAR_HOST_URL = 'http://sonar.leancloudandevops.online:9000'
        SONAR_HOST_URL = 'http://http://3.91.181.161:9000'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Tools') {
            steps {
                sh '''
                    java -version
                    mvn -version
                    ansible --version
                '''
            }
        }

        stage('Build and Test') {
            steps {
                sh 'mvn -B clean verify'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    withCredentials([
                        string(
                            credentialsId: 'sonar-token1',
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {
                        sh '''
                            set +x

                            mvn -B org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                              -Dsonar.projectKey=DevOps-Calculator-Web-Lakshmanan \
                              -Dsonar.projectName="DevOps Calculator Web Lakshmanan" \
                              -Dsonar.host.url="$SONAR_HOST_URL" \
                              -Dsonar.token="$SONAR_TOKEN" \
                              -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml \
                              -Dsonar.coverage.exclusions=**/CalculatorServlet.java
                        '''
                    }
                }
            }
        }

        stage('Verify WAR') {
            steps {
                sh '''
                    set -eu
                    test -f target/calculator.war
                    ls -lh target/calculator.war
                '''
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-user',
                        usernameVariable: 'NEXUS_USERNAME',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        SETTINGS_FILE="$(mktemp)"
                        trap 'rm -f "$SETTINGS_FILE"' EXIT

                        cat > "$SETTINGS_FILE" <<EOF
<settings>
    <servers>
        <server>
            <id>nexus-releases</id>
            <username>${NEXUS_USERNAME}</username>
            <password>${NEXUS_PASSWORD}</password>
        </server>
    </servers>
</settings>
EOF

                        chmod 600 "$SETTINGS_FILE"
                        mvn -B -s "$SETTINGS_FILE" deploy
                    '''
                }
            }
        }


stage('Provision Tomcat Server via Ansible') {
    steps {
        withCredentials([
            sshUserPrivateKey(
                credentialsId: 'ansible-target-ssh-student',
                keyFileVariable: 'ANSIBLE_SSH_KEY',
                usernameVariable: 'ANSIBLE_SSH_USER'
            )
        ]) {
            sh '''
                set -eu

                export ANSIBLE_CONFIG="$WORKSPACE/ansible/ansible.cfg"
                INVENTORY="$WORKSPACE/ansible/inventory.ini"

                echo "Step 1: Test Ansible connectivity"
                ansible calculator \
                    -i "$INVENTORY" \
                    -m ping \
                    --private-key="$ANSIBLE_SSH_KEY" \
                    -e "ansible_user=$ANSIBLE_SSH_USER"

                echo "Step 2: Install Java"
                ansible-playbook \
                    -i "$INVENTORY" \
                    "$WORKSPACE/ansible/install-java.yml" \
                    --private-key="$ANSIBLE_SSH_KEY" \
                    -e "ansible_user=$ANSIBLE_SSH_USER"

                echo "Step 3: Install and configure Tomcat"
                ansible-playbook \
                    -i "$INVENTORY" \
                    "$WORKSPACE/ansible/install-tomcat.yml" \
                    --private-key="$ANSIBLE_SSH_KEY" \
                    -e "ansible_user=$ANSIBLE_SSH_USER"

                echo "Server provisioning completed."
            '''
        }
    }
}




stage('Deploy to Tomcat via Ansible') {
    steps {
        withCredentials([
            sshUserPrivateKey(
                credentialsId: 'ansible-target-ssh-student',
                keyFileVariable: 'ANSIBLE_SSH_KEY',
                usernameVariable: 'ANSIBLE_SSH_USER'
            ),
            string(
                credentialsId: 'ansible-vault-password',
                variable: 'ANSIBLE_VAULT_PASSWORD'
            )
        ]) {
            sh '''
                set +x
                set -eu

                export ANSIBLE_CONFIG="$WORKSPACE/ansible/ansible.cfg"

                INVENTORY="$WORKSPACE/ansible/inventory.ini"
                PLAYBOOK="$WORKSPACE/ansible/deploy-calculator.yml"

                echo "Step 1: Validate Ansible files"
                test -r "$INVENTORY"
                test -r "$PLAYBOOK"
                test -r "$WORKSPACE/ansible/nexus-vault.yml"
                test -r "$ANSIBLE_SSH_KEY"

                echo "Step 2: Determine the Maven version"
                APP_VERSION="$(mvn -q -DforceStdout help:evaluate \
                    -Dexpression=project.version)"
                test -n "$APP_VERSION"
                echo "Application version: $APP_VERSION"

                echo "Step 3: Validate SSH key"
                ssh-keygen -y -f "$ANSIBLE_SSH_KEY" >/dev/null

                echo "Step 4: Test Ansible connectivity"
                ansible calculator \
                    -i "$INVENTORY" \
                    -m ping \
                    --private-key="$ANSIBLE_SSH_KEY" \
                    -e "ansible_user=$ANSIBLE_SSH_USER"

                echo "Step 5: Prepare temporary Vault password file"
                VAULT_PASS_FILE="$(mktemp)"
                trap 'rm -f "$VAULT_PASS_FILE"' EXIT
                chmod 600 "$VAULT_PASS_FILE"
                printf '%s' "$ANSIBLE_VAULT_PASSWORD" > "$VAULT_PASS_FILE"
                unset ANSIBLE_VAULT_PASSWORD

                echo "Step 6: Deploy application from Nexus"
                ansible-playbook \
                    -i "$INVENTORY" \
                    "$PLAYBOOK" \
                    --private-key="$ANSIBLE_SSH_KEY" \
                    --vault-password-file "$VAULT_PASS_FILE" \
                    -e "ansible_user=$ANSIBLE_SSH_USER" \
                    -e "artifact_version=$APP_VERSION"

                echo "Deployment succeeded for version $APP_VERSION"
            '''
        }
    }
}



















